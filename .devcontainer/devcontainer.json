{
  "name": "VUU",
  
   "hostRequirements": {
        "cpus": 2,
        "memory": "12gb", 
        "storage": "32gb"
    },

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    // Expose just the python-integration folder (not the whole repo) so the Dockerfile can
    // pre-install its requirements.txt.
    "options": [
      "--build-context=python-integration=${localWorkspaceFolder}/example/python-integration/python"
    ]
  },

  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "latest",
      "npmVersion": "latest"
    }
  },

  // Podman inside the container needs /dev/fuse (fuse-overlayfs), /dev/net/tun (pasta networking) and relaxed seccomp/AppArmor plus unmasked /proc
  // to create user namespaces and mounts.
  "runArgs": [
    "--device=/dev/fuse",
    "--device=/dev/net/tun",
    "--cap-add=SYS_ADMIN",
    "--cap-add=MKNOD",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--security-opt=label=disable",
    "--security-opt=systempaths=unconfined"
  ],

  // Testcontainers (plugin/clickhouse-plugin tests) talks to Podman through its Docker-compatible
  // API socket. Ryuk (Testcontainers' reaper) is disabled as it needs to mount the socket into a
  // privileged container, which rootless nested Podman can't do.
  "containerEnv": {
    "DOCKER_HOST": "unix:///home/vscode/.podman/podman.sock",
    "TESTCONTAINERS_RYUK_DISABLED": "true"
  },
  "postStartCommand": "/usr/local/bin/start-podman-service.sh",

  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Set *default* container specific settings.json values on container create.
      "settings": {},
      "extensions": [
        "Orta.vscode-jest",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "vscjava.vscode-java-pack"
      ]
    }
  },

  "forwardPorts": [5173, 8443, 8090]
}
