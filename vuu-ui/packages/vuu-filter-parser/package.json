{
  "name": "@vuu-ui/vuu-filter-parser",
  "version": "2.2.0",
  "main": "src/index.ts",
  "author": "heswell",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:dev": "node ../../scripts/run-build.mjs",
    "build": "node ../../scripts/run-build-rslib.ts",
    "lezer-generate:filter": "lezer-generator --output ./src/generated/filter-parser.ts ./src/grammar/filter.grammar",
    "type-defs": "node ../../scripts/build-type-defs.mjs",
    "tsc": "tsc --showConfig -p ./tsconfig-emit-types.json",
    "tsc:list": "tsc --listFilesOnly -p ./tsconfig-emit-types.json",
    "tsc:trace": "tsc --traceResolution -p ./tsconfig-emit-types.json"
  },
  "devDependencies": {
    "@vuu-ui/vuu-data-types": "2.2.0",
    "@vuu-ui/vuu-filter-types": "2.2.0",
    "@vuu-ui/vuu-table-types": "2.2.0"
  },
  "dependencies": {
    "@lezer/common": "^1.0.2",
    "@lezer/lr": "1.4.2",
    "@vuu-ui/vuu-utils": "2.2.0"
  }
}
