{
  "version": 1,
  "target": "remote-module",
  "paths": {
    "entry": "./src/index.tsx",
    "htmlTemplate": "../remote-module-template/index.html",
    "output": "../../dist_portal/feature-simple-div",
    "publicPath": "http://localhost:5007/"
  },
  "html": {
    "title": "simpleDiv (standalone)"
  },
  "server": {
    "corsOrigins": ["http://localhost:5001"]
  },
  "manifest": {
    "filename": "./config.json",
    "remote": {
      "connectionId": "simul",
      "restUrl": "https://localhost:8443/api/authn",
      "websocketUrl": "wss://localhost:8090/websocket"
    }
  },
  "moduleFederation": {
    "name": "simpleDiv",
    "dts": false,
    "exposes": {
      "./SimpleDiv": "./src/SimpleDiv",
      "./SimpleDivLocal": "./src/SimpleDivLocal"
    },
    "shared": {
      "react": {
        "requiredVersion": "^19.2.3",
        "strictVersion": true
      },
      "react-dom": {
        "requiredVersion": "^19.2.3",
        "strictVersion": true
      },
      "react-router-dom": {
        "singleton": true,
        "requiredVersion": "^7.18.3",
        "strictVersion": true
      },
      "@vuu-ui/core": {
        "singleton": true,
        "requiredVersion": "package",
        "strictVersion": true
      },
      "@vuu-ui/core/portal": {
        "singleton": true,
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-editing": {
        "singleton": true,
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-test": {
        "singleton": true,
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      },
      "@vuu-ui/vuu-shell": {
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      }
    }
  }
}
