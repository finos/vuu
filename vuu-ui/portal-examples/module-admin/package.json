{
  "name": "module-admin",
  "version": "1.0.0",
  "description": "Vuu Module Admin Module",
  "scripts": {
    "prebuild": "npm run build --workspace @vuu-ui/portal-build",
    "build": "portal-build --config ./portal-build.json",
    "dev": "rsbuild dev",
    "test": "vitest run --root ../.. portal-examples/module-admin/test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src test",
    "start": "ws --directory ../../dist_portal/module-admin --spa index.html --port 5002"
  },
  "type": "module",
  "private": true,
  "keywords": [],
  "author": "heswell",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "index.ts",
  "devDependencies": {
    "@vuu-ui/portal-build": "0.1.0",
    "@vuu-ui/vuu-data-types": "3.4.0",
    "@vuu-ui/vuu-table-types": "3.4.0",
    "@vuu-ui/vuu-theme": "3.4.0"
  },
  "dependencies": {
    "@heswell/module-admin": "1.1.0",
    "@salt-ds/core": "1.67.0",
    "@salt-ds/icons": "1.18.3",
    "@vuu-ui/core": "3.4.0",
    "@vuu-ui/vuu-data-test": "3.4.0",
    "@vuu-ui/vuu-notifications": "3.4.0",
    "@vuu-ui/vuu-protocol-types": "3.4.0",
    "@vuu-ui/vuu-utils": "3.4.0",
    "react-router-dom": "7.18.3"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "vuu": {
    "featureProps": {
      "vuuTables": [
        {
          "module": "MODULE_DISCOVERY",
          "table": "modules"
        },
        {
          "module": "MODULE_DISCOVERY",
          "table": "modulePermissions"
        }
      ]
    },
    "module-federation": {
      "exposes": {
        "./ModuleAdmin": "./src/ModuleAdmin",
        "./ModuleAdminLocal": "./src/ModuleAdminLocal"
      },
      "name": "moduleAdmin",
      "port": 5002
    }
  }
}
