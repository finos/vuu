{
  "version": 1,
  "paths": {
    "assetPrefix": "/",
    "htmlTemplate": "./public/index.html",
    "output": "../../dist_portal/portal-host",
    "entries": {
      "remote": "./src/index.tsx",
      "local": "./src/local-index.tsx"
    },
    "preEntry": "@vuu-ui/vuu-theme/index.css"
  },
  "manifest": {
    "filename": "./config.json",
    "remote": {
      "authUrl": "https://localhost:8080",
      "restUrl": "https://localhost:8443/api/authn",
      "websocketUrl": "wss://localhost:8091/websocket-portal"
    },
    "local": {
      "authUrl": "https://localhost:8080",
      "restUrl": "https://localhost:8443/api/authn",
      "websocketUrl": "wss://localhost:8091/websocket-portal"
    }
  },
  "moduleFederation": {
    "name": "host",
    "remoteType": "module",
    "remotes": {},
    "shared": {
      "react": {
        "requiredVersion": "package",
        "singleton": true,
        "strictVersion": true
      },
      "react-dom": {
        "requiredVersion": "package",
        "singleton": true,
        "strictVersion": true
      },
      "react-router-dom": {
        "requiredVersion": "package",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/core": {
        "requiredVersion": "package",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/core/portal": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      },
      "@heswell/grid-layout": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-editing": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-test": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/vuu-shell": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-remote": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/vuu-notifications": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      }
    }
  }
}
