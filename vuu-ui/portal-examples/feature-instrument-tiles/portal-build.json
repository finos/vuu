{
  "extends": "../portal-build.remote.json",
  "paths": {
    "entry": "./src/index.tsx",
    "output": "../../dist_portal/feature-instrument-tiles",
    "publicPath": "http://localhost:5007/"
  },
  "html": {
    "title": "instrumentTiles (standalone)"
  },
  "server": {
    "corsOrigins": [
      "http://localhost:5002"
    ]
  },
  "manifest": {
    "filename": "./config.json",
    "remote": {
      "connectionId": "simul",
      "restUrl": "https://localhost:8443/api/authn",
      "websocketUrl": "wss://localhost:8090/websocket"
    }
  },
  "moduleFederation": {
    "name": "instrumentTiles",
    "exposes": {
      "./VuuInstrumentTilesFeature": "./src/VuuInstrumentTilesFeature"
    }
  }
}
