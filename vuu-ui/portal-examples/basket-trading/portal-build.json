{
  "extends": "../portal-build.remote.json",
  "paths": {
    "entry": "./src/index.tsx",
    "output": "../../dist_portal/basket-trading",
    "publicPath": "http://localhost:5006/"
  },
  "html": {
    "title": "basketTrading (standalone)"
  },
  "server": {
    "corsOrigins": [
      "http://localhost:5002"
    ]
  },
  "manifest": {
    "filename": "./config.json",
    "remote": {
      "connectionId": "basket",
      "restUrl": "https://localhost:8445/api/authn",
      "websocketUrl": "wss://localhost:8093/websocket-basket-trading"
    }
  },
  "moduleFederation": {
    "name": "basketTrading",
    "exposes": {
      "./VuuBasketTradingFeature": "./src/VuuBasketTradingFeature",
      "./VuuBasketTradingFeatureLocal": "./src/VuuBasketTradingFeatureLocal"
    }
  }
}
