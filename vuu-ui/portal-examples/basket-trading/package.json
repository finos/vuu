{
  "name": "basket-trading",
  "version": "3.3.2",
  "description": "Basket Trading",
  "scripts": {
    "prebuild": "npm run build --workspace @vuu-ui/portal-build",
    "build": "portal-build --config ./portal-build.json",
    "dev": "rsbuild dev",
    "start": "ws --directory ../../dist_portal/basket-trading --spa index.html --port 5006"
  },
  "private": true,
  "keywords": [],
  "author": "heswell",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "index.ts",
  "devDependencies": {
    "@vuu-ui/portal-build": "0.1.0",
    "@vuu-ui/vuu-data-types": "4.0.0-alpha.20",
    "@vuu-ui/vuu-filter-types": "4.0.0-alpha.20",
    "@vuu-ui/vuu-protocol-types": "4.0.0-alpha.20",
    "@vuu-ui/vuu-table-types": "4.0.0-alpha.20"
  },
  "dependencies": {
    "@vuu-ui/vuu-data-remote": "4.0.0-alpha.20",
    "@vuu-ui/vuu-data-react": "4.0.0-alpha.20",
    "@vuu-ui/vuu-data-test": "4.0.0-alpha.20",
    "@vuu-ui/vuu-filters": "4.0.0-alpha.20",
    "@vuu-ui/vuu-layout": "4.0.0-alpha.20",
    "@vuu-ui/vuu-notifications": "4.0.0-alpha.20",
    "@vuu-ui/vuu-shell": "4.0.0-alpha.20",
    "@vuu-ui/vuu-table": "4.0.0-alpha.20",
    "@vuu-ui/vuu-table-extras": "4.0.0-alpha.20",
    "@vuu-ui/vuu-theme": "4.0.0-alpha.20",
    "@vuu-ui/vuu-utils": "4.0.0-alpha.20",
    "@salt-ds/core": "1.67.0",
    "@vuu-ui/core": "4.0.0-alpha.20"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "vuu": {
    "viewProps": {
      "header": false
    },
    "featureProps": {
      "vuuTables": [
        {
          "module": "BASKET",
          "table": "basket"
        },
        {
          "module": "BASKET",
          "table": "basketTrading"
        },
        {
          "module": "BASKET",
          "table": "basketTradingConstituentJoin"
        },
        {
          "module": "BASKET",
          "table": "basketConstituent"
        }
      ]
    },
    "module-federation": {
      "exposes": {
        "./VuuBasketTradingFeature": "./src/VuuBasketTradingFeature",
        "./VuuBasketTradingFeatureLocal": "./src/VuuBasketTradingFeatureLocal"
      },
      "name": "basketTrading",
      "port": 5006
    },
    "leftNavLocation": "vuu-features"
  }
}
