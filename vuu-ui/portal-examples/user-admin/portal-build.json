{
  "version": 1,
  "target": "remote-module",
  "paths": {
    "entry": "./src/index.tsx",
    "htmlTemplate": "../remote-module-template/index.html",
    "output": "../../dist_portal/user-admin",
    "publicPath": "http://localhost:5003/"
  },
  "html": {
    "title": "userAdmin (standalone)"
  },
  "server": {
    "corsOrigins": ["http://localhost:5001"]
  },
  "manifest": {
    "filename": "./config.json",
    "remote": {
      "connectionId": "user-admin",
      "restUrl": "https://localhost:8444/api/authn",
      "websocketUrl": "wss://localhost:8092/websocket-user-admin"
    }
  },
  "moduleFederation": {
    "name": "userAdmin",
    "dts": false,
    "exposes": {
      "./UserAdmin": "./src/UserAdmin",
      "./UserAdminLocal": "./src/UserAdminLocal"
    },
    "shared": {
      "react": {
        "requiredVersion": "^19.2.3",
        "strictVersion": true
      },
      "react-dom": {
        "requiredVersion": "^19.2.3",
        "strictVersion": true
      },
      "react-router-dom": {
        "singleton": true,
        "requiredVersion": "^7.18.3",
        "strictVersion": true
      },
      "@vuu-ui/core": {
        "singleton": true,
        "requiredVersion": "package",
        "strictVersion": true
      },
      "@vuu-ui/core/portal": {
        "singleton": true,
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-editing": {
        "singleton": true,
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-test": {
        "singleton": true,
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      },
      "@vuu-ui/vuu-shell": {
        "requiredVersion": "package:@vuu-ui/core",
        "strictVersion": true
      },
      "@vuu-ui/vuu-data-remote": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      },
      "@vuu-ui/vuu-notifications": {
        "requiredVersion": "package:@vuu-ui/core",
        "singleton": true,
        "strictVersion": true
      }
    }
  }
}
