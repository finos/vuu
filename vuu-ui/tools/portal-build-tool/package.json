{
  "name": "@vuu-ui/portal-build",
  "version": "0.1.0",
  "description": "Reusable Rsbuild and Module Federation build tool for portal applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "portal-build": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node ./scripts/set-cli-permissions.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run --root ../.. tools/portal-build-tool/test",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@module-federation/enhanced": "2.8.0",
    "@rsbuild/core": "^2.1.3",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsdoctor/rspack-plugin": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.0",
    "vitest": "3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
