{
  "name": "vuu-table-browser",
  "version": "1.0.0",
  "description": "Browse tables exposed by registered Vuu servers",
  "scripts": {
    "build": "node ../../scripts/build-remote-module.ts",
    "start": "serve -p 5009 ../../deployed_apps/vuu-table-browser"
  },
  "type": "module",
  "private": true,
  "author": "heswell",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "index.ts",
  "dependencies": {
    "@salt-ds/core": "1.67.0",
    "@vuu-ui/core": "3.3.1",
    "@vuu-ui/vuu-data-types": "3.3.1",
    "@vuu-ui/vuu-protocol-types": "3.3.1",
    "@vuu-ui/vuu-shell": "3.3.1",
    "react-router-dom": "^6.2.1"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "vuu": {
    "featureProps": {},
    "module-federation": {
      "exposes": {
        "./VuuTableBrowser": "src/VuuTableBrowser"
      },
      "name": "vuuTableBrowser",
      "port": 5009
    }
  }
}
