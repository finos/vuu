{
  "name": "vuu-ui",
  "version": "3.3.2",
  "author": "heswell <steve@heswell.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "experiments/**",
    "packages/**",
    "sample-apps/**",
    "portal-examples/**",
    "!portal-examples/app-vuu-example",
    "!portal-examples/standalone-table",
    "tools/vite-plugin-inline-css",
    "tools/rsbuild-plugin-inline-css",
    "tools/portal-build-tool",
    "tools/vuu-showcase",
    "tools/vuu-theme-model"
  ],
  "scripts": {
    "build": "node ./scripts/build-all-rslib.ts",
    "bump:versions": "node ./scripts/bump-versions.ts",
    "build:app": "cd sample-apps/app-vuu-example && node scripts/build.ts",
    "build:dev": "node ./scripts/build-all.mjs",
    "prebuild:mf": "npm run build --workspace @vuu-ui/portal-build",
    "build:mf": "portal-build --all-config ./portal-build-all.json",
    "postbuild:mf": "node ./portal-examples/scripts/set-portal-urls.ts",
    "build:mf:local": "npm run build:mf -- --local",
    "portal:serve": "node ./portal-examples/scripts/set-portal-urls.ts && npm exec --workspace @vuu-ui/portal-build -- portal-serve start --config ../../portal-serve.config.json",
    "portal:launch": "node ./portal-examples/scripts/set-portal-urls.ts",
    "portal:stop": "npm exec --workspace @vuu-ui/portal-build -- portal-serve stop --config ../../portal-serve.config.json",
    "build:app:insecure": "npm run build:app -- --insecure",
    "build:table": "cd sample-apps/standalone-table && node scripts/build.ts",
    "build:packages": "npm run build -- --cjs --license && npm run type-defs",
    "build:packages:debug": "npm run build -- --cjs --debug && npm run type-defs -- --debug",
    "build:worker": "cd packages/vuu-data-remote && npm run build:worker",
    "launch:app": "node ./scripts/launch-app.ts",
    "send:notification": "node ./scripts/send-notification.ts",
    "generate:basket-data": "node ./scripts/generate-basket-data.ts",
    "launch:table": "node ./scripts/launch-table.mjs",
    "launch:demo:electron": "cd tools/electron && node ./node_modules/.bin/electron .",
    "lint": "biome lint",
    "lint:error": "biome lint --diagnostic-level=error",
    "format:check": "biome check --skip=lint --skip=assist",
    "format": "biome format --write .",
    "bump:versions": "node ./scripts/bump-versions.ts",
    "deploy:websocket-test": "node ./tools/deploy-websocket-test.mjs",
    "type-defs": "node ./scripts/build-all-type-defs.mjs",
    "showcase": "npm run build:theme-model && cd showcase && tsx ../tools/vuu-showcase/scripts/showcase-dev.ts",
    "showcase:anatomy": "tsx tools/vuu-showcase/scripts/anatomy/extract-anatomy.ts",
    "showcase:engine": "VUU_DATA_ENGINE=local npm run showcase",
    "showcase:build": "npm run build:worker && npm run build:theme-model && cd showcase && tsx ../tools/vuu-showcase/scripts/showcase-build.ts --build-only",
    "showcase:prod": "npm run build:worker && npm run build:theme-model && cd showcase && tsx ../tools/vuu-showcase/scripts/showcase-build.ts",
    "playwright:gallery": "rsbuild dev --config playwright/gallery/rsbuild.config.ts",
    "playwright:gallery:build": "rsbuild build --config playwright/gallery/rsbuild.config.ts",
    "playwright:gallery:serve": "serve --single --listen 3100 playwright/gallery/dist",
    "bench:dev": "npm run build:worker && rsbuild dev --config benchmarks/app/rsbuild.config.ts",
    "bench:build": "npm run build:worker && rsbuild build --config benchmarks/app/rsbuild.config.ts && rsbuild build --config benchmarks/app/rsbuild.config.ts --env-mode profiling",
    "bench": "playwright test --config=benchmarks/playwright.config.ts",
    "bench:compare": "tsx benchmarks/scripts/compare.ts",
    "bench:publish": "tsx benchmarks/scripts/publish-results.ts",
    "bench:report": "tsx benchmarks/scripts/report.ts",
    "bench:mock-server": "tsx benchmarks/scripts/mock-vuu-server.ts",
    "bench:micro": "vitest bench --run --config benchmarks/micro/vitest.config.ts",
    "playwright:coverage": "node playwright/generate-coverage.cjs",
    "test:playwright:components": "playwright test --config=playwright.config.ts --project=components-chromium",
    "test:playwright:perf": "VUU_PERF=1 playwright test --config=playwright.config.ts --project=components-chromium Table-scroll-performance",
    "test:vite": "npm run build:worker && vitest run",
    "pub": "node ./scripts/publish.ts",
    "typecheck": "tsc --noEmit --project tsconfig-typecheck.json",
    "patch-package": "patch-package",
    "postinstall": "npm run patch-package",
    "build:theme-model": "npm run build --workspace=@vuu-ui/vuu-theme-model",
    "tsc:version": "tsc --version",
    "tsgo:version": "tsgo --version"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.0.0",
    "@types/react": ">=18.3.3",
    "@types/react-dom": ">=18.0.0",
    "clsx": "^2.0.0",
    "html-to-image": "^1.11.11",
    "patch-package": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "semver": "^7.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@lezer/generator": "^1.2.2",
    "@playwright/test": "1.64.1",
    "@module-federation/enhanced": "2.8.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "6.0.3",
    "@rsbuild/core": "^2.1.3",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsdoctor/rspack-plugin": "^1.6.1",
    "@rslib/core": "0.23.2",
    "@salt-ds/core": "1.74.0",
    "@testing-library/dom": "^9.0.0",
    "@types/jsdom": "^21.1.2",
    "@types/serve-handler": "^6.1.4",
    "babel-plugin-istanbul": "^8.0.0",
    "chalk": "^5.2.0",
    "csv-parse": "^7.0.3",
    "esbuild": "0.27.2",
    "happy-dom": "^21.0.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.6",
    "tinycolor2": "1.4.2",
    "tsx": "^4.19.1",
    "typescript": "7.0.2",
    "vite": "6.4.5",
    "vitest": "3.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
