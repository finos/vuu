{
  "compilerOptions": {
    "noImplicitAny": true,
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext", "WebWorker"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // "noEmit": true,
    "jsx": "react-jsx",
    "sourceMap": true
  },
  "include": [
    "packages/*/src",
    "sample-apps/*/src",
    "portal-examples/*/src",
    "showcase/src",
    "sample-apps/*/index.ts",
    "portal-examples/*/index.ts",
    "global.d.ts"
  ],
  "exclude": ["**/*test-utils.ts", "**/*.cy.*", "**/*.test.*"]
}
